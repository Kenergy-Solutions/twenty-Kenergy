# Vorlage. Auf dem Server nach .env kopieren und ausfuellen.
# Die .env selbst gehoert NICHT ins Repo, sie steht in .gitignore.
#
# Jedes Secret hier neu erzeugen. Niemals einen Wert aus einer Anleitung,
# einem Chat oder der lokalen Entwicklungsumgebung uebernehmen.

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------

# Die echte Domain, unter der Twenty erreichbar ist. Der A-Record muss auf
# die statische IP der Instanz zeigen, bevor Caddy zum ersten Mal startet.
DOMAIN=crm.kenergy-solutions.de

# Adresse fuer Let's Encrypt (Ablaufwarnungen).
ACME_EMAIL=admin@kenergy-solutions.de

# Muss die echte HTTPS-Domain sein, nicht localhost. Das Protokoll
# entscheidet, ob das Session-Cookie als Secure gesetzt wird, und die
# Variable landet als API_URL in jeder Logic Function. Steht hier
# localhost, laufen die Funktionen im Worker-Container ins Leere.
SERVER_URL=https://crm.kenergy-solutions.de

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# openssl rand -base64 32
#
# Verschluesselt ruhende Daten: die privaten JWT-Signaturschluessel, die
# 2FA-Secrets, die OAuth-Token verbundener Konten und die Variablen der
# installierten Apps. Ausserdem wird daraus das Signaturgeheimnis fuer das
# Session-Cookie abgeleitet.
#
# Aendern ohne FALLBACK_ENCRYPTION_KEY macht alle verschluesselten Zeilen
# unlesbar und wirft jeden eingeloggten Nutzer raus. Siehe BETRIEB.md.
ENCRYPTION_KEY=

# openssl rand -hex 32
#
# Postgres-Passwort. Wird sowohl an den db-Container als auch in die
# PG_DATABASE_URL von Server und Worker eingesetzt.
PG_DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------

# Welches Image gezogen wird. "latest" fuer den letzten Build von main,
# oder ein Git-SHA, um gezielt eine Version festzunageln. Fuer einen
# Rollback den vorherigen SHA eintragen und "docker compose up -d".
TAG=latest

# ---------------------------------------------------------------------------
# Backup
# ---------------------------------------------------------------------------

# S3-Bucket fuer die naechtlichen Dumps, ohne s3:// Prefix.
BACKUP_S3_BUCKET=kenergy-twenty-backups

# Wie lange Dumps aufbewahrt werden.
BACKUP_RETENTION_DAYS=30

# Der Zugriff auf S3 laeuft ueber die IAM-Rolle bzw. das Profil der
# Instanz, siehe README. Deshalb stehen hier bewusst KEINE AWS-Keys.

# ---------------------------------------------------------------------------
# Selten zu aendern
# ---------------------------------------------------------------------------

PG_DATABASE_USER=postgres
PG_DATABASE_NAME=default
STORAGE_TYPE=local

# Muss ueber Caddys upstream-keepalive von 120s liegen. Der Default im
# Server ist 65000 und auf nginx mit 60s abgestimmt, nicht auf Caddy.
SERVER_KEEP_ALIVE_TIMEOUT_MS=125000

# LOCAL fuehrt Logic Functions als Kindprozess im Container aus. Der
# Default waere unter NODE_ENV=production DISABLED, und dann scheitert
# schon die Installation der App. LAMBDA braucht AWS-Region und IAM-Rolle
# und lohnt sich hier nicht.
LOGIC_FUNCTION_TYPE=LOCAL

# Nur bei einer Schluesselrotation setzen: hier kommt der ALTE
# ENCRYPTION_KEY rein, damit die mit ihm verschluesselten Zeilen weiter
# lesbar bleiben. Sonst leer lassen.
FALLBACK_ENCRYPTION_KEY=
